{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "description": "Clearing Agent Platform API (NestJS, modular monolith).",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"{src,test,migrations}/**/*.{ts,cjs}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "db:migrate": "node-pg-migrate up --migrations-dir migrations --database-url-var DATABASE_MIGRATION_URL",
    "db:rollback": "node-pg-migrate down --migrations-dir migrations --database-url-var DATABASE_MIGRATION_URL",
    "db:create": "node-pg-migrate create --migrations-dir migrations"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.5",
    "@nestjs/core": "^11.0.5",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^11.0.5",
    "@nestjs/swagger": "^11.0.3",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.7",
    "helmet": "^8.0.0",
    "kysely": "^0.29.6",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.5",
    "@swc/core": "^1.10.7",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.2.4"
  }
}
