{
  "name": "z-clear",
  "version": "0.0.0",
  "private": true,
  "description": "Z Clear: multi-tenant SaaS for Zambian clearing and forwarding agents.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -r --parallel --if-present dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "pnpm audit --audit-level high",
    "secrets:scan": "gitleaks detect --no-banner --redact",
    "verify:storage": "node --env-file=.env.local scripts/verify-neon-upload.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-presigned-post": "^3.1179.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "files-sdk": "^3.2.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core",
      "embedded-postgres",
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/darwin-x64",
      "@embedded-postgres/linux-arm",
      "@embedded-postgres/linux-arm64",
      "@embedded-postgres/linux-ia32",
      "@embedded-postgres/linux-ppc64",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/windows-x64"
    ],
    "overrides": {
      "tinypool": "^2.1.2",
      "body-parser": "^2.4.0",
      "multer": "^2.5.0"
    }
  },
  "dependencies": {
    "@neon/config": "^1.14.8",
    "@neon/env": "^2.1.11"
  }
}
