# ---------------------------------------------------------------------------
# Copy to .env for local development. NEVER commit a real .env.
# Values here are safe placeholders only.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
API_PORT=3000
API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:5173
LOG_LEVEL=debug

# Database (PostgreSQL 15+)
DATABASE_URL=postgresql://app:change_me@localhost:5432/clearing_dev
# Least-privilege migration role (owns schema changes only)
DATABASE_MIGRATION_URL=postgresql://migrator:change_me@localhost:5432/clearing_dev

# CORS: comma-separated allowed origins (empty = same-origin only)
CORS_ALLOWLIST=http://localhost:5173

# Web build-time API origin. Leave empty locally: Vite proxies /api to :3000.
# On Render this is injected from the API service's public URL at build time.
VITE_API_ORIGIN=

# Auth (generate real values with: openssl rand -base64 48)
# Access token lifetime (e.g. 15m, 1h) and refresh token lifetime in days.
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL_DAYS=30
# Lockout after this many failed logins, for this many minutes.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCK_MINUTES=15
# 32+ byte secret, base64. MUST be changed in production.
AUTH_JWT_SECRET=replace-with-32-byte-base64-secret
# Refresh cookie honours Secure only when this is true (set true in production).
COOKIE_SECURE=false
# Optional cookie domain (leave empty for host-only cookies).
COOKIE_DOMAIN=
# Secret used to hash public status tokens at rest (never store raw)
PUBLIC_LINK_TOKEN_PEPPER=replace-with-32-byte-base64-secret

# Local demo seed only. DEMO_PASSWORD is read by seed-review-demo.ts to hash
# the four synthetic demo logins and by smoke-review.ts to sign in. Never set
# this on Render or use a real password here.
DEMO_PASSWORD=replace-with-local-demo-only-password

# File storage
# Driver: memory (dev/test only, loses files on restart) | s3 (S3-compatible, required in production)
STORAGE_DRIVER=memory
# Uploads larger than this are rejected with 413.
MAX_UPLOAD_BYTES=15728640
# Comma-separated accepted content types.
ALLOWED_UPLOAD_TYPES=application/pdf,image/jpeg,image/png,application/vnd.openxmlformats-officedocument.wordprocessingml.document
# S3-compatible storage (private buckets only). Required when STORAGE_DRIVER=s3.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=clearing-dev-files
S3_ACCESS_KEY_ID=change_me
S3_SECRET_ACCESS_KEY=change_me
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300

# Malware scanning. noop reports "skipped" (no scanner bundled);
# clamav speaks INSTREAM to an external clamd. Failed scans block downloads.
SCAN_PROVIDER=noop
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=5000

# Notifications. Implemented providers: mock | sms_mock | email.
# sms_mock records outcomes in the outbox and sends nothing (local interface).
# sms and whatsapp are roadmap only and fail closed if selected.
NOTIFICATION_PROVIDER=mock
NOTIFICATION_FROM=
# Generic transactional-email webhook. Keep the token out of source control.
# NOTIFICATION_WEBHOOK_URL=https://email.example.com/send
# NOTIFICATION_WEBHOOK_TOKEN=replace-with-provider-token
NOTIFICATION_TIMEOUT_MS=5000

# Compliance / tariff data. Rules live in an external JSON file, never in code.
# Each rule needs hsCode, description, rateBp, sourceUrl, effectiveDate and
# verificationStatus. Without a file the estimator refuses every request.
# COMPLIANCE_RULES_FILE=/absolute/path/to/tariff-rules.json
# Demo-only: allow SAMPLE rules to produce a clearly labelled estimate.
COMPLIANCE_SAMPLE_MODE=false

# Feature flags
FEATURE_AI=false
FEATURE_NOTIFICATIONS=false
# Optional AI wording for importer review messages. When false (default) a
# fixed deterministic template is used; no model is wired in this phase.
# REVIEW_AI_MODEL= (reserved for a later phase; keep provider keys out of code)
