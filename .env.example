# ---------------------------------------------------------------------------
# Copy to .env for local development. NEVER commit a real .env.
# Values here are safe placeholders only.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
API_PORT=3000
API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:5173
LOG_LEVEL=debug

# Database (PostgreSQL 15+)
DATABASE_URL=postgresql://app:change_me@localhost:5432/clearing_dev
# Least-privilege migration role (owns schema changes only)
DATABASE_MIGRATION_URL=postgresql://migrator:change_me@localhost:5432/clearing_dev

# CORS: comma-separated allowed origins (empty = same-origin only)
CORS_ALLOWLIST=http://localhost:5173

# Auth (generate real values with: openssl rand -base64 48)
# Access token lifetime (e.g. 15m, 1h) and refresh token lifetime in days.
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL_DAYS=30
# Lockout after this many failed logins, for this many minutes.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCK_MINUTES=15
# 32+ byte secret, base64. MUST be changed in production.
AUTH_JWT_SECRET=replace-with-32-byte-base64-secret
# Refresh cookie honours Secure only when this is true (set true in production).
COOKIE_SECURE=false
# Optional cookie domain (leave empty for host-only cookies).
COOKIE_DOMAIN=
# Secret used to hash public status tokens at rest (never store raw)
PUBLIC_LINK_TOKEN_PEPPER=replace-with-32-byte-base64-secret

# File storage (S3-compatible, private buckets only)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=clearing-dev-files
S3_ACCESS_KEY_ID=change_me
S3_SECRET_ACCESS_KEY=change_me
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300

# Notifications (Phase 4). Provider: mock | sms | whatsapp | email
NOTIFICATION_PROVIDER=mock
NOTIFICATION_FROM=
# Example provider placeholders (fill in Phase 4, keep out of source):
# SMS_API_KEY=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# SMTP_URL=

# Feature flags
FEATURE_AI=false
FEATURE_NOTIFICATIONS=false
